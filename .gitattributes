# Store text files with LF in the repo and check them out with LF on every OS
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touch binary files
*.png  binary
*.jpg  binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.webm binary