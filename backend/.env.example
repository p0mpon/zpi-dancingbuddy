# Copy to .env and fill in. .env is gitignored; this file is the committed template.
# docker compose loads .env into both the backend and db containers.

# Which settings module to use: zpi_app.settings.dev | .prod | .test
DJANGO_SETTINGS_MODULE=zpi_app.settings.dev

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Prod only, e.g. https://dancingbuddy.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL. The postgres image uses these to create the DB/user on first start;
# Django uses the same values to connect. Host "db" is the compose service name.
POSTGRES_DB=dancingbuddy
POSTGRES_USER=dancingbuddy
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Max DB connections per process (web worker / celery worker).
POSTGRES_POOL_MAX_SIZE=10

# Celery queue (Redis). Host "redis" is the compose service name.
CELERY_BROKER_URL=redis://redis:6379/0

# Email (prod only; dev prints emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
